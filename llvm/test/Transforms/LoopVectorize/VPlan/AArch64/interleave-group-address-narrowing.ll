loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %mul = shl nuw nsw i64 %iv, 1
  %gep.src.0 = getelementptr inbounds i32, ptr %src, i64 %mul
  %l.0 = load i32, ptr %gep.src.0, align 4
  %add.1 = or disjoint i64 %mul, 1
  %gep.src.1 = getelementptr inbounds i32, ptr %src, i64 %add.1
  %l.1 = load i32, ptr %gep.src.1, align 4
  %sum = add i32 %l.0, %l.1
  %sub = sub i32 %l.0, %l.1
